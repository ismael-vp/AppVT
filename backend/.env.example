# ==========================================
# CONFIGURACIÓN DEL ENTORNO (PhishingScanner)
# ==========================================

# --- SECRETOS OBLIGATORIOS ---
# Clave para acceder a la IA de OpenAI (GPT-4o-mini)
OPENAI_API_KEY=tu_api_key_de_openai_aqui

# Clave maestra para vaciar la caché manualmente vía API
ADMIN_SECRET_KEY=UnaClaveSecretaMuyLarga123!

# --- CORTAFUEGOS (CORS) ---
# Separado por comas. Si usas Vercel, pon la URL de Vercel aquí.
# Ejemplo: https://phishscan.qzz.io,http://localhost:3000
ALLOWED_ORIGINS=*

# --- SECRETOS OPCIONALES ---
# Google Safe Browsing — 10.000 req/día GRATIS
# Obtener en: https://console.cloud.google.com → habilitar "Safe Browsing API"
GOOGLE_SAFE_BROWSING_API_KEY=

# PhishTank — Opcional, evita rate-limiting del feed JSON
# Obtener en: https://www.phishtank.com/api_register.php
PHISHTANK_API_KEY=

# AbuseIPDB — Opcional, para reputación de IPs
ABUSEIPDB_API_KEY=

# --- CACHÉ Y REDIS (PRODUCCIÓN) ---
# Si se deja vacío, el sistema usará SQLite local automáticamente.
# IMPORTANTE: Para Upstash usar el esquema 'rediss://' (con doble 's')
REDIS_URL=
