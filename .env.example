# --- CONFIGURACIÓN GLOBAL DE PRODUCCIÓN ---

# URL Pública de tu API (donde está alojado el backend, usado por el frontend)
NEXT_PUBLIC_API_URL=https://api.tu-dominio.com

# --- VARIABLES DEL BACKEND ---
# Entorno de ejecución
ENVIRONMENT=production

# Claves de APIs Externas
VT_API_KEY=tu_clave_de_virustotal
OPENAI_API_KEY=tu_clave_de_openai

# Orígenes Permitidos (CORS) - Añade aquí el dominio exacto de tu frontend en Vercel
ALLOWED_ORIGINS=https://tu-dominio-frontend.vercel.app,http://localhost:3000

# --- VARIABLES DEL FRONTEND (Vercel) ---
# Nota: Si el frontend se despliega en Vercel, estas variables deben configurarse en el panel de Vercel.
# Supabase
NEXT_PUBLIC_SUPABASE_URL=tu_url_de_supabase
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_anon_key_de_supabase

# Cloudflare Turnstile (Captcha)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=tu_site_key_de_turnstile
